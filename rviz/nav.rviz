Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.05
      Color: 255; 0; 0
      Style: Flat Squares
    - Class: rviz/PoseArray
      Name: AMCL Particles
      Enabled: true
      Topic: /particlecloud
    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 200; 0
    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 0; 0; 255
    - Class: rviz/Map
      Name: Global Costmap
      Enabled: false
      Topic: /move_base/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz/Map
      Name: Local Costmap
      Enabled: false
      Topic: /move_base/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 8
      Focal Point:
        X: 3.5
        Y: 1.75
        Z: 0
